# Vaire deployment configuration — copy to deploy.env and fill in your values.
# deploy.env is gitignored and sourced by migration scripts.

# Remote server (where Vaire will run)
VAIRE_DEPLOY_HOST=""              # SSH alias or IP (e.g., "myserver")
VAIRE_DEPLOY_IP=""                # Mesh/LAN IP for HTTPS bind (e.g., "10.0.0.1")
VAIRE_DEPLOY_USER=""              # Remote username
VAIRE_DEPLOY_REPO_DIR=""          # Repo path on remote (e.g., "/home/user/workspace/vaire")
VAIRE_DEPLOY_DATA_DIR=""          # Data dir on remote (e.g., "/home/user/.vaire")
VAIRE_DEPLOY_WORKSPACE=""         # Workspace root on remote (e.g., "/home/user/workspace")
VAIRE_DEPLOY_GIT_REMOTE=""        # Git clone URL
VAIRE_DEPLOY_GIT_BRANCH="main"    # Branch to deploy
VAIRE_DEPLOY_HTTPS_PORT="8743"    # HTTPS port for mTLS
